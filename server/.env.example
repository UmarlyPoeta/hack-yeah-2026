# Copy to server/.env and fill in. Never commit server/.env.
PORT=8787

# LLM: Bielik behind an Ollama API on Modal (server/modal/README.md)
OLLAMA_URL=https://<workspace>--bielik-ollama-serve.modal.run
LLM_MODEL=bielik-4.5b-v3.0-instruct:Q8_0
# Modal proxy auth: send as headers Modal-Key / Modal-Secret on every LLM request
MODAL_KEY=
MODAL_SECRET=

# Text-to-speech: elevenlabs | piper | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Offline fallback voice. Windows: piper_windows_amd64.zip from github.com/rhasspy/piper/releases (set full path),
# voice files from huggingface.co/rhasspy/piper-voices (pl/pl_PL/gosia/medium) into server/voices/.
# Smoke test of both providers: node --env-file=.env scripts/tts-smoke.js [voices]
PIPER_BIN=piper
PIPER_VOICE=./voices/pl_PL-gosia-medium.onnx
FFMPEG_BIN=ffmpeg

CACHE_DIR=./.cache
