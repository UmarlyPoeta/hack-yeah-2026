# Copy to server/.env and fill in. Never commit server/.env.
PORT=8787

# Local LLM via Ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=bielik-4.5b-v3.0-instruct:Q4_K_M

# Text-to-speech: elevenlabs | piper | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Offline fallback voice
PIPER_BIN=piper
PIPER_VOICE=./voices/pl_PL-gosia-medium.onnx
FFMPEG_BIN=ffmpeg

CACHE_DIR=./.cache
