# Copy to server/.env and fill in the keys. Never commit server/.env.
PORT=8787

# LLM: Claude through the Anthropic API (default). Haiku 4.5 costs about 0.003-0.005 USD per segment.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# LLM timeouts for /v1/segment (ms)
LLM_TIMEOUT_MS=60000
LLM_DEEP_DIVE_TIMEOUT_MS=90000

# Optional: LLM_PROVIDER=ollama uses Bielik behind an Ollama API on Modal instead (server/modal/README.md)
OLLAMA_URL=https://<workspace>--bielik-ollama-serve.modal.run
LLM_MODEL=bielik-4.5b-v3.0-instruct:Q8_0
# Modal proxy auth: sent as headers Modal-Key / Modal-Secret on every Bielik request
MODAL_KEY=
MODAL_SECRET=

# Text-to-speech: elevenlabs | piper | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_TIMEOUT_MS=20000
# true: template segments may also use ElevenLabs (default: Piper only, saves the 10k/month free characters)
TTS_CLOUD_FOR_TEMPLATES=false

# Offline fallback voice
PIPER_BIN=piper
PIPER_VOICE=./voices/pl_PL-gosia-medium.onnx
FFMPEG_BIN=ffmpeg

CACHE_DIR=./.cache
