# Copy to server/.env and fill in. Never commit server/.env.
PORT=8787

# LLM: Bielik behind an Ollama API on Modal (server/modal/README.md)
OLLAMA_URL=https://<workspace>--bielik-ollama-serve.modal.run
LLM_MODEL=bielik-4.5b-v3.0-instruct:Q8_0
# Modal proxy auth: send as headers Modal-Key / Modal-Secret on every LLM request
MODAL_KEY=
MODAL_SECRET=
# LLM timeouts for /v1/segment (ms)
LLM_TIMEOUT_MS=45000

# LLM_PROVIDER=claude uses the Anthropic API instead of Bielik (npm run start:claude sets it).
# Haiku 4.5: about 0.003-0.005 USD per segment.
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
LLM_DEEP_DIVE_TIMEOUT_MS=90000

# Text-to-speech: elevenlabs | piper | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_TIMEOUT_MS=20000
# true: template segments may also use ElevenLabs (default: Piper only, saves the 10k/month free characters)
TTS_CLOUD_FOR_TEMPLATES=false

# Offline fallback voice
PIPER_BIN=piper
PIPER_VOICE=./voices/pl_PL-gosia-medium.onnx
FFMPEG_BIN=ffmpeg

CACHE_DIR=./.cache
